{
  "name": "SDF_API08_ChiusuraMensile",
  "description": "API08 – HR chiude il mese (le richieste Validate da HR diventano Incluse nel riepilogo mensile) oppure l'Amministratore lo riapre. Risponde prima di aggiornare le richieste. Parametri: anno, mese, azione, nota.",
  "connectionReferences": {
    "shared_sharepointonline": {
      "connectionName": "shared-sharepointonl-00000000-0000-0000-0000-000000000000",
      "source": "Embedded",
      "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
      "tier": "NotSpecified"
    },
    "shared_office365": {
      "connectionName": "shared-office365-00000000-0000-0000-0000-000000000000",
      "source": "Embedded",
      "id": "/providers/Microsoft.PowerApps/apis/shared_office365",
      "tier": "NotSpecified"
    }
  },
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      },
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "PowerAppV2",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "number": {
                "title": "anno",
                "type": "number",
                "x-ms-dynamically-added": true,
                "description": "Anno del periodo",
                "x-ms-content-hint": "NUMBER"
              },
              "number_1": {
                "title": "mese",
                "type": "number",
                "x-ms-dynamically-added": true,
                "description": "Mese del periodo (1-12)",
                "x-ms-content-hint": "NUMBER"
              },
              "text": {
                "title": "azione",
                "type": "string",
                "x-ms-dynamically-added": true,
                "description": "chiudi oppure riapri",
                "x-ms-content-hint": "TEXT"
              },
              "text_1": {
                "title": "nota",
                "type": "string",
                "x-ms-dynamically-added": true,
                "description": "Nota HR (obbligatoria per riapri: motivo della riapertura)",
                "x-ms-content-hint": "TEXT"
              }
            },
            "required": [
              "number",
              "number_1",
              "text",
              "text_1"
            ]
          }
        }
      }
    },
    "actions": {
      "Inizializza_SitoUrl": {
        "type": "InitializeVariable",
        "runAfter": {},
        "inputs": {
          "variables": [
            {
              "name": "SitoUrl",
              "type": "string",
              "value": "{{SITO_URL}}"
            }
          ]
        }
      },
      "Chiamante": {
        "description": "Identità di chi chiama, dall'intestazione della chiamata di Power Apps.",
        "type": "Compose",
        "runAfter": {
          "Inizializza_SitoUrl": [
            "Succeeded"
          ]
        },
        "inputs": "@toLower(trim(coalesce(triggerOutputs()?['headers']?['x-ms-user-email'], '')))"
      },
      "Chiamante_OData": {
        "type": "Compose",
        "runAfter": {
          "Chiamante": [
            "Succeeded"
          ]
        },
        "inputs": "@replace(outputs('Chiamante'), '''', '''''')"
      },
      "Leggi_configurazione": {
        "description": "Legge i parametri della lista Configurazione.",
        "type": "OpenApiConnection",
        "runAfter": {
          "Chiamante_OData": [
            "Succeeded"
          ]
        },
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@variables('SitoUrl')",
            "table": "Configurazione",
            "$top": 500
          },
          "authentication": "@parameters('$authentication')"
        }
      },
      "Seleziona_configurazione": {
        "type": "Select",
        "runAfter": {
          "Leggi_configurazione": [
            "Succeeded"
          ]
        },
        "inputs": {
          "from": "@body('Leggi_configurazione')?['value']",
          "select": {
            "@item()?['Title']": "@item()?['Valore']"
          }
        }
      },
      "Configurazione": {
        "description": "Oggetto chiave/valore: outputs('Configurazione')?['EmailHR'], ?['AppUrl'], ...",
        "type": "Compose",
        "runAfter": {
          "Seleziona_configurazione": [
            "Succeeded"
          ]
        },
        "inputs": "@json(replace(replace(replace(string(body('Seleziona_configurazione')),'[{','{'),'}]','}'),'},{',','))"
      },
      "Inizializza_IdChiusura": {
        "type": "InitializeVariable",
        "runAfter": {
          "Configurazione": [
            "Succeeded"
          ]
        },
        "inputs": {
          "variables": [
            {
              "name": "IdChiusura",
              "type": "integer",
              "value": 0
            }
          ]
        }
      },
      "Prova": {
        "type": "Scope",
        "runAfter": {
          "Inizializza_IdChiusura": [
            "Succeeded"
          ]
        },
        "actions": {
          "Anno": {
            "type": "Compose",
            "runAfter": {},
            "inputs": "@int(triggerBody()?['number'])"
          },
          "Mese": {
            "type": "Compose",
            "runAfter": {
              "Anno": [
                "Succeeded"
              ]
            },
            "inputs": "@int(triggerBody()?['number_1'])"
          },
          "Azione": {
            "type": "Compose",
            "runAfter": {
              "Mese": [
                "Succeeded"
              ]
            },
            "inputs": "@toLower(trim(coalesce(triggerBody()?['text'], '')))"
          },
          "Nota": {
            "type": "Compose",
            "runAfter": {
              "Azione": [
                "Succeeded"
              ]
            },
            "inputs": "@trim(coalesce(triggerBody()?['text_1'], ''))"
          },
          "Periodo": {
            "type": "Compose",
            "runAfter": {
              "Nota": [
                "Succeeded"
              ]
            },
            "inputs": "@concat(string(outputs('Anno')), '-', formatNumber(outputs('Mese'), '00'))"
          },
          "Leggi_ruoli_chiamante": {
            "description": "Ruoli applicativi attivi del chiamante.",
            "type": "OpenApiConnection",
            "runAfter": {
              "Periodo": [
                "Succeeded"
              ]
            },
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "GetItems",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@variables('SitoUrl')",
                "table": "Ruoli applicativi",
                "$filter": "Title eq '@{outputs('Chiamante_OData')}' and Attivo eq 1",
                "$top": 10
              },
              "authentication": "@parameters('$authentication')"
            }
          },
          "Leggi_chiusura": {
            "type": "OpenApiConnection",
            "runAfter": {
              "Periodo": [
                "Succeeded"
              ]
            },
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "GetItems",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@variables('SitoUrl')",
                "table": "Chiusure mensili",
                "$filter": "Title eq '@{outputs('Periodo')}'",
                "$top": 1
              },
              "authentication": "@parameters('$authentication')"
            }
          },
          "Ruoli_chiamante": {
            "type": "Select",
            "runAfter": {
              "Leggi_ruoli_chiamante": [
                "Succeeded"
              ],
              "Leggi_chiusura": [
                "Succeeded"
              ]
            },
            "inputs": {
              "from": "@body('Leggi_ruoli_chiamante')?['value']",
              "select": "@item()?['Ruolo']?['Value']"
            }
          },
          "Chiusura": {
            "type": "Compose",
            "runAfter": {
              "Ruoli_chiamante": [
                "Succeeded"
              ]
            },
            "inputs": "@first(body('Leggi_chiusura')?['value'])"
          },
          "Stato_periodo": {
            "type": "Compose",
            "runAfter": {
              "Chiusura": [
                "Succeeded"
              ]
            },
            "inputs": "@coalesce(outputs('Chiusura')?['StatoPeriodo']?['Value'], 'Aperto')"
          },
          "Controlli_chiusura": {
            "type": "Compose",
            "runAfter": {
              "Stato_periodo": [
                "Succeeded"
              ]
            },
            "inputs": "@if(not(contains(createArray('chiudi', 'riapri'), outputs('Azione'))), 'Azione non valida.', if(or(less(outputs('Mese'), 1), greater(outputs('Mese'), 12), less(outputs('Anno'), 2000), greater(outputs('Anno'), 2100)), 'Periodo non valido.', if(and(equals(outputs('Azione'), 'chiudi'), not(or(contains(body('Ruoli_chiamante'), 'Formazione HR'), contains(body('Ruoli_chiamante'), 'Amministratore')))), 'Operazione riservata all''Ufficio HR/Formazione e agli amministratori.', if(and(equals(outputs('Azione'), 'riapri'), not(contains(body('Ruoli_chiamante'), 'Amministratore'))), 'Solo un amministratore può riaprire un mese chiuso.', if(and(equals(outputs('Azione'), 'chiudi'), equals(outputs('Stato_periodo'), 'Chiuso')), concat('Il periodo ', outputs('Periodo'), ' è già chiuso.'), if(and(equals(outputs('Azione'), 'riapri'), not(equals(outputs('Stato_periodo'), 'Chiuso'))), concat('Il periodo ', outputs('Periodo'), ' non è chiuso.'), if(and(equals(outputs('Azione'), 'riapri'), empty(outputs('Nota'))), 'La motivazione della riapertura è obbligatoria.', '')))))))"
          },
          "Se_controlli_non_superati": {
            "type": "If",
            "runAfter": {
              "Controlli_chiusura": [
                "Succeeded"
              ]
            },
            "expression": {
              "and": [
                {
                  "equals": [
                    "@not(empty(outputs('Controlli_chiusura')))",
                    true
                  ]
                }
              ]
            },
            "actions": {
              "Rispondi_controlli_non_superati": {
                "type": "Response",
                "kind": "PowerApp",
                "runAfter": {},
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "esito": "ERRORE",
                    "messaggio": "@{outputs('Controlli_chiusura')}",
                    "dati": "{}"
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "esito": {
                        "title": "esito",
                        "x-ms-dynamically-added": true,
                        "type": "string"
                      },
                      "messaggio": {
                        "title": "messaggio",
                        "x-ms-dynamically-added": true,
                        "type": "string"
                      },
                      "dati": {
                        "title": "dati",
                        "x-ms-dynamically-added": true,
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "Termina_controlli_non_superati": {
                "type": "Terminate",
                "runAfter": {
                  "Rispondi_controlli_non_superati": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "runStatus": "Succeeded"
                }
              }
            },
            "else": {
              "actions": {}
            }
          },
          "Ruolo_registro": {
            "type": "Compose",
            "runAfter": {
              "Se_controlli_non_superati": [
                "Succeeded"
              ]
            },
            "inputs": "@if(and(equals(outputs('Azione'), 'chiudi'), contains(body('Ruoli_chiamante'), 'Formazione HR')), 'Formazione HR', 'Amministratore')"
          },
          "Se_chiudi": {
            "description": "chiudi: HR o Amministratore · riapri: solo Amministratore.",
            "type": "If",
            "runAfter": {
              "Ruolo_registro": [
                "Succeeded"
              ]
            },
            "expression": {
              "and": [
                {
                  "equals": [
                    "@equals(outputs('Azione'), 'chiudi')",
                    true
                  ]
                }
              ]
            },
            "actions": {
              "Se_chiusura_esistente": {
                "description": "Crea o aggiorna l'elemento Chiusure mensili con Title = AAAA-MM.",
                "type": "If",
                "runAfter": {},
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@not(empty(outputs('Chiusura')))",
                        true
                      ]
                    }
                  ]
                },
                "actions": {
                  "Aggiorna_chiusura": {
                    "type": "OpenApiConnection",
                    "runAfter": {},
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "@variables('SitoUrl')",
                        "table": "Chiusure mensili",
                        "id": "@outputs('Chiusura')?['ID']",
                        "item/Title": "@outputs('Periodo')",
                        "item/Mese": "@outputs('Mese')",
                        "item/Anno": "@outputs('Anno')",
                        "item/StatoPeriodo/Value": "Chiuso",
                        "item/DataChiusura": "@utcNow()",
                        "item/UtenteChiusura": "@outputs('Chiamante')",
                        "item/NoteHR": "@outputs('Nota')"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  },
                  "Imposta_id_chiusura": {
                    "type": "SetVariable",
                    "runAfter": {
                      "Aggiorna_chiusura": [
                        "Succeeded"
                      ]
                    },
                    "inputs": {
                      "name": "IdChiusura",
                      "value": "@outputs('Chiusura')?['ID']"
                    }
                  }
                },
                "else": {
                  "actions": {
                    "Crea_chiusura": {
                      "type": "OpenApiConnection",
                      "runAfter": {},
                      "inputs": {
                        "host": {
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PostItem",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@variables('SitoUrl')",
                          "table": "Chiusure mensili",
                          "item/Title": "@outputs('Periodo')",
                          "item/Mese": "@outputs('Mese')",
                          "item/Anno": "@outputs('Anno')",
                          "item/StatoPeriodo/Value": "Chiuso",
                          "item/DataChiusura": "@utcNow()",
                          "item/UtenteChiusura": "@outputs('Chiamante')",
                          "item/NoteHR": "@outputs('Nota')"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Imposta_id_chiusura_nuova": {
                      "type": "SetVariable",
                      "runAfter": {
                        "Crea_chiusura": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "name": "IdChiusura",
                        "value": "@body('Crea_chiusura')?['ID']"
                      }
                    }
                  }
                }
              },
              "Registro_chiusura": {
                "type": "OpenApiConnection",
                "runAfter": {
                  "Se_chiusura_esistente": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@variables('SitoUrl')",
                    "table": "Registro modifiche",
                    "item/Title": "Chiusura mensile",
                    "item/Tabella": "Chiusure mensili",
                    "item/IdRecord": "@{string(variables('IdChiusura'))}",
                    "item/Campo": "StatoPeriodo",
                    "item/ValorePrecedente": "@{outputs('Stato_periodo')}",
                    "item/ValoreNuovo": "Chiuso",
                    "item/Ruolo/Value": "@outputs('Ruolo_registro')",
                    "item/LoginAutore": "@outputs('Chiamante')",
                    "item/Nota": "@{outputs('Nota')}"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              },
              "Leggi_richieste_validate": {
                "type": "OpenApiConnection",
                "runAfter": {
                  "Registro_chiusura": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "GetItems",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@variables('SitoUrl')",
                    "table": "Richieste formazione",
                    "$filter": "AnnoCompetenza eq @{string(outputs('Anno'))} and MeseCompetenza eq @{string(outputs('Mese'))} and Stato eq 'Validata da HR'",
                    "$top": 5000
                  },
                  "authentication": "@parameters('$authentication')"
                }
              },
              "Dati_chiusura": {
                "type": "Compose",
                "runAfter": {
                  "Leggi_richieste_validate": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "periodo": "@outputs('Periodo')",
                  "stato": "Chiuso",
                  "richiesteIncluse": "@length(body('Leggi_richieste_validate')?['value'])"
                }
              },
              "Rispondi_chiusura": {
                "type": "Response",
                "kind": "PowerApp",
                "runAfter": {
                  "Dati_chiusura": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "esito": "OK",
                    "messaggio": "@{concat('Mese ', outputs('Periodo'), ' chiuso: ', string(length(body('Leggi_richieste_validate')?['value'])), ' richieste validate incluse nel riepilogo mensile.')}",
                    "dati": "@string(outputs('Dati_chiusura'))"
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "esito": {
                        "title": "esito",
                        "x-ms-dynamically-added": true,
                        "type": "string"
                      },
                      "messaggio": {
                        "title": "messaggio",
                        "x-ms-dynamically-added": true,
                        "type": "string"
                      },
                      "dati": {
                        "title": "dati",
                        "x-ms-dynamically-added": true,
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "Includi_richieste": {
                "description": "Dopo la risposta: Validata da HR -> Inclusa nel riepilogo mensile.",
                "type": "Foreach",
                "runAfter": {
                  "Rispondi_chiusura": [
                    "Succeeded"
                  ]
                },
                "foreach": "@body('Leggi_richieste_validate')?['value']",
                "actions": {
                  "Includi_richiesta": {
                    "type": "OpenApiConnection",
                    "runAfter": {},
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "@variables('SitoUrl')",
                        "table": "Richieste formazione",
                        "id": "@items('Includi_richieste')?['ID']",
                        "item/Title": "@items('Includi_richieste')?['Title']",
                        "item/Stato/Value": "Inclusa nel riepilogo mensile",
                        "item/PeriodoChiusura": "@outputs('Periodo')",
                        "item/UltimaModificaDa": "@outputs('Chiamante')"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  }
                },
                "runtimeConfiguration": {
                  "concurrency": {
                    "repetitions": 10
                  }
                }
              },
              "Leggi_richieste_incluse": {
                "type": "OpenApiConnection",
                "runAfter": {
                  "Includi_richieste": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "GetItems",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@variables('SitoUrl')",
                    "table": "Richieste formazione",
                    "$filter": "AnnoCompetenza eq @{string(outputs('Anno'))} and MeseCompetenza eq @{string(outputs('Mese'))} and (Stato eq 'Inclusa nel riepilogo mensile' or Stato eq 'Inviata a Payroll')",
                    "$top": 5000
                  },
                  "authentication": "@parameters('$authentication')"
                }
              },
              "Ore_incluse": {
                "type": "Select",
                "runAfter": {
                  "Leggi_richieste_incluse": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "from": "@body('Leggi_richieste_incluse')?['value']",
                  "select": {
                    "ore": "@float(coalesce(item()?['OreRetribuiteHR'], 0))",
                    "gettoni": "@float(coalesce(item()?['OreGettoneHR'], 0))"
                  }
                }
              },
              "Xml_ore_incluse": {
                "type": "Compose",
                "runAfter": {
                  "Ore_incluse": [
                    "Succeeded"
                  ]
                },
                "inputs": "@xml(json(concat('{\"r\":{\"x\":', string(body('Ore_incluse')), '}}')))"
              },
              "Totali_chiusura": {
                "description": "Totali del periodo (incluse + già inviate a Payroll).",
                "type": "Compose",
                "runAfter": {
                  "Xml_ore_incluse": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "numero": "@length(body('Leggi_richieste_incluse')?['value'])",
                  "ore": "@float(formatNumber(xpath(outputs('Xml_ore_incluse'), 'sum(/r/x/ore)'), '0.00', 'en-US'))",
                  "gettoni": "@float(formatNumber(xpath(outputs('Xml_ore_incluse'), 'sum(/r/x/gettoni)'), '0.00', 'en-US'))"
                }
              },
              "Aggiorna_totali_chiusura": {
                "type": "OpenApiConnection",
                "runAfter": {
                  "Totali_chiusura": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PatchItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@variables('SitoUrl')",
                    "table": "Chiusure mensili",
                    "id": "@variables('IdChiusura')",
                    "item/Title": "@outputs('Periodo')",
                    "item/Mese": "@outputs('Mese')",
                    "item/Anno": "@outputs('Anno')",
                    "item/NumeroRichieste": "@outputs('Totali_chiusura')?['numero']",
                    "item/TotaleOreRiconosciute": "@outputs('Totali_chiusura')?['ore']",
                    "item/TotaleGettoni": "@outputs('Totali_chiusura')?['gettoni']"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              },
              "Registro_inclusione": {
                "type": "OpenApiConnection",
                "runAfter": {
                  "Aggiorna_totali_chiusura": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@variables('SitoUrl')",
                    "table": "Registro modifiche",
                    "item/Title": "Richieste incluse nel riepilogo mensile",
                    "item/Tabella": "Chiusure mensili",
                    "item/IdRecord": "@{string(variables('IdChiusura'))}",
                    "item/Campo": "NumeroRichieste",
                    "item/ValoreNuovo": "@{string(outputs('Totali_chiusura')?['numero'])}",
                    "item/Ruolo/Value": "@outputs('Ruolo_registro')",
                    "item/LoginAutore": "@outputs('Chiamante')",
                    "item/Nota": "@{concat(string(length(body('Leggi_richieste_validate')?['value'])), ' richieste da Validata da HR a Inclusa nel riepilogo mensile. Totale ore retribuite: ', formatNumber(float(coalesce(outputs('Totali_chiusura')?['ore'], 0)), '0.##', 'it-IT'), ' · totale ore gettone: ', formatNumber(float(coalesce(outputs('Totali_chiusura')?['gettoni'], 0)), '0.##', 'it-IT'))}"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            },
            "else": {
              "actions": {
                "Riapri_periodo": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@variables('SitoUrl')",
                      "table": "Chiusure mensili",
                      "id": "@outputs('Chiusura')?['ID']",
                      "item/Title": "@outputs('Periodo')",
                      "item/Mese": "@outputs('Mese')",
                      "item/Anno": "@outputs('Anno')",
                      "item/StatoPeriodo/Value": "Riaperto",
                      "item/DataRiapertura": "@utcNow()",
                      "item/UtenteRiapertura": "@outputs('Chiamante')",
                      "item/MotivoRiapertura": "@outputs('Nota')"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Registro_riapertura": {
                  "type": "OpenApiConnection",
                  "runAfter": {
                    "Riapri_periodo": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PostItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@variables('SitoUrl')",
                      "table": "Registro modifiche",
                      "item/Title": "Riapertura mensile",
                      "item/Tabella": "Chiusure mensili",
                      "item/IdRecord": "@{string(outputs('Chiusura')?['ID'])}",
                      "item/Campo": "StatoPeriodo",
                      "item/ValorePrecedente": "Chiuso",
                      "item/ValoreNuovo": "Riaperto",
                      "item/Ruolo/Value": "Amministratore",
                      "item/LoginAutore": "@outputs('Chiamante')",
                      "item/Nota": "@{outputs('Nota')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Dati_riapertura": {
                  "type": "Compose",
                  "runAfter": {
                    "Registro_riapertura": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "periodo": "@outputs('Periodo')",
                    "stato": "Riaperto",
                    "richiesteIncluse": 0
                  }
                },
                "Rispondi_riapertura": {
                  "type": "Response",
                  "kind": "PowerApp",
                  "runAfter": {
                    "Dati_riapertura": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "statusCode": 200,
                    "body": {
                      "esito": "OK",
                      "messaggio": "@{concat('Mese ', outputs('Periodo'), ' riaperto.')}",
                      "dati": "@string(outputs('Dati_riapertura'))"
                    },
                    "schema": {
                      "type": "object",
                      "properties": {
                        "esito": {
                          "title": "esito",
                          "x-ms-dynamically-added": true,
                          "type": "string"
                        },
                        "messaggio": {
                          "title": "messaggio",
                          "x-ms-dynamically-added": true,
                          "type": "string"
                        },
                        "dati": {
                          "title": "dati",
                          "x-ms-dynamically-added": true,
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "Email_riapertura_HR": {
                  "type": "OpenApiConnection",
                  "runAfter": {
                    "Rispondi_riapertura": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@{outputs('Configurazione')?['EmailHR']}",
                      "emailMessage/Subject": "Riapertura del mese @{outputs('Periodo')}",
                      "emailMessage/Body": "<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#323130;max-width:680px;margin:0 auto\"><div style=\"background:#005E7D;color:#FFFFFF;padding:16px 24px;font-size:18px;font-weight:600\">Gestione ore formazione – Società Dolce</div><div style=\"padding:20px 24px;border:1px solid #E1DFDD;border-top:0\"><p style=\"margin:0 0 12px 0;font-size:17px;font-weight:600;color:#005E7D\">Mese riaperto</p><p style=\"margin:0 0 16px 0;line-height:1.5\">Un amministratore ha riaperto un mese già chiuso: le richieste del periodo tornano modificabili secondo le regole dell'app. Le richieste già incluse nel riepilogo restano incluse.</p><table style=\"border-collapse:collapse;width:100%;margin:0 0 16px 0\"><tr><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;color:#605E5C;width:42%;vertical-align:top\">Periodo</td><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;vertical-align:top\">@{concat(createArray('gennaio','febbraio','marzo','aprile','maggio','giugno','luglio','agosto','settembre','ottobre','novembre','dicembre')[sub(outputs('Mese'), 1)], ' ', string(outputs('Anno')))}</td></tr><tr><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;color:#605E5C;width:42%;vertical-align:top\">Riaperto da</td><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;vertical-align:top\">@{outputs('Chiamante')}</td></tr><tr><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;color:#605E5C;width:42%;vertical-align:top\">Data</td><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;vertical-align:top\">@{convertFromUtc(utcNow(), 'W. Europe Standard Time', 'dd/MM/yyyy HH:mm')}</td></tr><tr><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;color:#605E5C;width:42%;vertical-align:top\">Numero richieste incluse</td><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;vertical-align:top\">@{string(coalesce(outputs('Chiusura')?['NumeroRichieste'], 0))}</td></tr><tr><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;color:#605E5C;width:42%;vertical-align:top\">File paghe già generato</td><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;vertical-align:top\">@{if(equals(outputs('Chiusura')?['FilePagheGenerato'], true), concat('Sì (versione ', string(coalesce(outputs('Chiusura')?['VersioneFile'], 0)), ')'), 'No')}</td></tr></table><div style=\"margin:0 0 16px 0;padding:10px 14px;background:#F3F2F1;border-left:4px solid #005E7D;line-height:1.5\"><b>Motivo della riapertura</b><br>@{replace(replace(replace(replace(string(coalesce(outputs('Nota'), '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), decodeUriComponent('%0A'), '<br>')}</div><p style=\"margin:24px 0 8px 0\"><a href=\"@{outputs('Configurazione')?['AppUrl']}\" style=\"background:#005E7D;color:#FFFFFF;text-decoration:none;padding:10px 22px;border-radius:4px;display:inline-block;font-weight:600\">Apri l'app</a></p></div><div style=\"padding:12px 24px;font-size:12px;color:#8A8886\">Messaggio automatico – non rispondere.</div></div>",
                      "emailMessage/From": "@{coalesce(outputs('Configurazione')?['MittenteEmail'], '')}",
                      "emailMessage/Importance": "Normal"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            }
          }
        }
      },
      "Errore": {
        "description": "Eseguito solo se 'Prova' non riesce: risponde con un errore generico e avvisa HR.",
        "type": "Scope",
        "runAfter": {
          "Prova": [
            "Failed",
            "TimedOut"
          ]
        },
        "actions": {
          "Rispondi_errore_imprevisto": {
            "type": "Response",
            "kind": "PowerApp",
            "runAfter": {},
            "inputs": {
              "statusCode": 200,
              "body": {
                "esito": "ERRORE",
                "messaggio": "Si è verificato un errore imprevisto. Riprova più tardi o contatta l'Ufficio HR/Formazione.",
                "dati": "{}"
              },
              "schema": {
                "type": "object",
                "properties": {
                  "esito": {
                    "title": "esito",
                    "x-ms-dynamically-added": true,
                    "type": "string"
                  },
                  "messaggio": {
                    "title": "messaggio",
                    "x-ms-dynamically-added": true,
                    "type": "string"
                  },
                  "dati": {
                    "title": "dati",
                    "x-ms-dynamically-added": true,
                    "type": "string"
                  }
                }
              }
            }
          },
          "Link_esecuzione": {
            "type": "Compose",
            "runAfter": {
              "Rispondi_errore_imprevisto": [
                "Succeeded",
                "Failed",
                "Skipped",
                "TimedOut"
              ]
            },
            "inputs": "@concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])"
          },
          "Azioni_non_riuscite": {
            "type": "Query",
            "runAfter": {
              "Link_esecuzione": [
                "Succeeded"
              ]
            },
            "inputs": {
              "from": "@result('Prova')",
              "where": "@equals(item()?['status'], 'Failed')"
            }
          },
          "Dettaglio_azioni_non_riuscite": {
            "type": "Select",
            "runAfter": {
              "Azioni_non_riuscite": [
                "Succeeded"
              ]
            },
            "inputs": {
              "from": "@body('Azioni_non_riuscite')",
              "select": "@concat(item()?['name'], ': ', coalesce(item()?['error']?['message'], item()?['code'], ''))"
            }
          },
          "Avvisa_HR_errore": {
            "type": "OpenApiConnection",
            "runAfter": {
              "Dettaglio_azioni_non_riuscite": [
                "Succeeded"
              ]
            },
            "inputs": {
              "host": {
                "connectionName": "shared_office365",
                "operationId": "SendEmailV2",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
              },
              "parameters": {
                "emailMessage/To": "@{outputs('Configurazione')?['EmailHR']}",
                "emailMessage/Subject": "Errore nel flusso @{workflow()?['tags']?['flowDisplayName']}",
                "emailMessage/Body": "<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#323130;max-width:680px;margin:0 auto\"><div style=\"background:#005E7D;color:#FFFFFF;padding:16px 24px;font-size:18px;font-weight:600\">Gestione ore formazione – Società Dolce</div><div style=\"padding:20px 24px;border:1px solid #E1DFDD;border-top:0\"><p style=\"margin:0 0 12px 0;font-size:17px;font-weight:600;color:#005E7D\">Errore in un flusso</p><p style=\"margin:0 0 16px 0;line-height:1.5\">Un flusso dell'app non è stato completato. Apri l'esecuzione per i dettagli.</p><table style=\"border-collapse:collapse;width:100%;margin:0 0 16px 0\"><tr><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;color:#605E5C;width:42%;vertical-align:top\">Flusso</td><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;vertical-align:top\">@{workflow()?['tags']?['flowDisplayName']}</td></tr><tr><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;color:#605E5C;width:42%;vertical-align:top\">Data e ora</td><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;vertical-align:top\">@{convertFromUtc(utcNow(), 'W. Europe Standard Time', 'dd/MM/yyyy HH:mm')}</td></tr><tr><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;color:#605E5C;width:42%;vertical-align:top\">Utente che ha chiamato</td><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;vertical-align:top\">@{outputs('Chiamante')}</td></tr><tr><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;color:#605E5C;width:42%;vertical-align:top\">Azioni non riuscite</td><td style=\"padding:7px 10px;border-bottom:1px solid #EDEBE9;vertical-align:top\">@{replace(replace(replace(string(coalesce(join(body('Dettaglio_azioni_non_riuscite'), ' | '), '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr></table><p style=\"margin:24px 0 8px 0\"><a href=\"@{outputs('Link_esecuzione')}\" style=\"background:#005E7D;color:#FFFFFF;text-decoration:none;padding:10px 22px;border-radius:4px;display:inline-block;font-weight:600\">Apri l'esecuzione</a></p></div><div style=\"padding:12px 24px;font-size:12px;color:#8A8886\">Messaggio automatico – non rispondere.</div></div>",
                "emailMessage/From": "@{coalesce(outputs('Configurazione')?['MittenteEmail'], '')}",
                "emailMessage/Importance": "High"
              },
              "authentication": "@parameters('$authentication')"
            }
          },
          "Termina_con_errore": {
            "type": "Terminate",
            "runAfter": {
              "Avvisa_HR_errore": [
                "Succeeded",
                "Failed",
                "Skipped",
                "TimedOut"
              ]
            },
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "ErroreFlusso",
                "message": "Errore nel blocco Prova: vedere le azioni non riuscite."
              }
            }
          }
        }
      }
    }
  }
}
